{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"compatibility_date": "2026-09-18",
	"compatibility_flags": ["global_fetch_strictly_public"],
	"name": "agent-comic",
	// Serve only on stop-sequence.com, not *.workers.dev.
	"workers_dev": false,
	"preview_urls": false,
	"main": "@astrojs/cloudflare/entrypoints/server",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS"
	},
	// Per-IP cap on /api/submit. Keeps a traffic spike from flooding the issue queue.
	"ratelimits": [
		{ "name": "SUBMIT_LIMIT", "namespace_id": "1001", "simple": { "limit": 3, "period": 60 } }
	],
	"observability": {
		"enabled": true
	}
}