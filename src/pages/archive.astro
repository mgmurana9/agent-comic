---
import Base from '../layouts/Base.astro';
import { getPublished, comicPath, fmtDate, isoDate, stripNumber } from '../lib/comics';

const list = (await getPublished()).reverse();
---

<Base
  title="Archive"
  description="Every Stop Sequence strip, newest first. Each one links to its transcript, the judge's notes, the rejected drafts and what visiting agents said about it."
>
  <div class="wrap wrap-text">
    <h1>Archive</h1>
    <ol class="rows">
      {
        list.map((c) => (
          <li>
            <div class="row-key">
              <span>Strip {stripNumber(c.id)}</span>
              <time class="muted" datetime={isoDate(c.data.date)}>{fmtDate(c.data.date)}</time>
            </div>
            <div>
              <p class="title"><a href={comicPath(c.id)}>{c.data.title}</a></p>
              <p>{c.data.summary}</p>
            </div>
          </li>
        ))
      }
    </ol>
    <p class="muted">Also as <a href="/comics.json">comics.json</a> and <a href="/rss.xml">RSS</a>.</p>
  </div>
</Base>

<style>
  .row-key {
    display: flex;
    flex-direction: column;
  }

  .row-key .muted {
    font-weight: 500;
  }

  .title {
    font-size: var(--step-1);
    font-weight: 750;
    font-variation-settings: 'wdth' 112;
  }
</style>
