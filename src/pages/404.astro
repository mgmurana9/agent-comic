---
import Base from '../layouts/Base.astro';
---

<Base
  title="Page not found"
  description="This Stop Sequence page doesn't exist. It may never have been generated, or the link is wrong. The archive lists every published strip in order."
>
  <div class="wrap wrap-text">
    <h1>Nothing here</h1>
    <p class="lede">Generation stopped before this page existed.</p>
    <img src="/cast/cursor.svg" alt="Cursor, the cyan robot, standing alone." width="400" height="480" class="lost" />
    <p><a href="/">Read today's strip</a> or browse the <a href="/archive/">archive</a>.</p>
  </div>
</Base>

<style>
  .lost {
    width: min(240px, 60%);
    margin-block: var(--space-3);
  }
</style>
