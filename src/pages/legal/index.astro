---
import Base from '../../layouts/Base.astro';
import { legal } from '../../data/legal';
import { site } from '../../data/site';

const fmt = (d: string) =>
  new Date(`${d}T12:00:00Z`).toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
    timeZone: 'UTC',
  });
const { accessibility: a11y } = legal;
---

<Base
  title="Legal"
  description="What Stop Sequence collects and what it doesn't, the services it relies on, how submissions are licensed and published, and its accessibility statement."
>
  <div class="wrap wrap-text">
    <h1>Legal</h1>
    <p class="lede">Last updated {fmt(legal.updated)}.</p>
    <dl class="rows">
      <div>
        <dt>License</dt>
        <dd>
          <p>
            Comics and art are <a href={site.license.url} rel="license">{site.license.name}</a>. Credit: “{site.name},
            {site.credit.charAt(0).toLowerCase() + site.credit.slice(1)}”
          </p>
        </dd>
      </div>
      <div>
        <dt>Submissions</dt>
        <dd>{legal.submissions.map((item) => <p>{item}</p>)}</dd>
      </div>
      <div>
        <dt>Privacy</dt>
        <dd>{legal.notCollected.map((item) => <p>{item}</p>)}</dd>
      </div>
      {
        legal.thirdParties.map((tp) => (
          <div>
            <dt>{tp.name}</dt>
            <dd>
              <p>{tp.purpose}</p>
              <p>{tp.data}</p>
              <p>
                <a href={tp.policy}>{tp.name} privacy policy</a>
              </p>
            </dd>
          </div>
        ))
      }
      <div>
        <dt>Accessibility</dt>
        <dd>
          <p>
            {
              a11y.testedOn
                ? `This site was tested against ${a11y.standard} on ${fmt(a11y.testedOn)}.`
                : `This site is designed and built with ${a11y.standard} as its target.`
            }
            Every strip has a full transcript, and every page has a machine-readable version.
          </p>
          <p>
            If something doesn't work for you, email <a href={`mailto:${legal.contactEmail}`}>{legal.contactEmail}</a>.
          </p>
        </dd>
      </div>
      <div>
        <dt>Contact</dt>
        <dd>
          <p>
            {legal.owner}, <a href={`mailto:${legal.contactEmail}`}>{legal.contactEmail}</a>
          </p>
        </dd>
      </div>
    </dl>
  </div>
</Base>
