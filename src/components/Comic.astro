---
import type { Comic } from '../lib/comics';
import { transcript, fmtDate, isoDate } from '../lib/comics';
import { PANEL } from '../data/site';

interface Props {
  comic: Comic;
  /** Heading level for the comic title. The home page and permalink both use h1. */
  headingId?: string;
  eager?: boolean;
}

const { comic, headingId = 'comic-title', eager = true } = Astro.props;
const { title, date, panels, placeholder } = comic.data;
---

<article class="comic" aria-labelledby={headingId}>
  <header>
    <h1 id={headingId}>{title}</h1>
    <p class="meta"><time datetime={isoDate(date)}>{fmtDate(date)}</time>{placeholder && ' · placeholder art'}</p>
  </header>

  <ol class="panels" aria-label="Panels">
    {
      panels.map((p, i) => (
        <li class="panel">
          <img
            src={p.art}
            alt={p.alt}
            width={PANEL.width}
            height={PANEL.height}
            loading={eager && i === 0 ? 'eager' : 'lazy'}
            fetchpriority={eager && i === 0 ? 'high' : undefined}
            decoding="async"
          />
          {p.dialogue.map((d) => (
            <p class:list={['line', `line--${d.kind}`, `pos-${d.position}`]}>
              {d.kind === 'speech' || d.kind === 'thought' ? (
                <span class="visually-hidden">{d.speaker}{d.kind === 'thought' ? ' thinks' : ' says'}: </span>
              ) : null}
              {d.text}
            </p>
          ))}
        </li>
      ))
    }
  </ol>

  <details class="transcript">
    <summary>Transcript</summary>
    <pre>{transcript(comic)}</pre>
  </details>
</article>

<style>
  .panels {
    display: grid;
    gap: var(--space-3);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 768px) {
    .panels {
      grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    }
  }

  .panel {
    position: relative;
    border: 1px solid var(--color-border);
  }

  .panel img {
    width: 100%;
  }

  .line {
    position: absolute;
    max-width: 55%;
    margin: var(--space-2);
    padding: var(--space-1) var(--space-2);
    background: var(--color-bg);
    border: 1px solid var(--color-text);
    font-size: 0.9375rem;
    line-height: 1.3;
  }

  .line--caption {
    border-radius: 0;
  }

  .pos-top-left { top: 0; left: 0; }
  .pos-top { top: 0; left: 50%; translate: -50% 0; }
  .pos-top-right { top: 0; right: 0; }
  .pos-bottom-left { bottom: 0; left: 0; }
  .pos-bottom { bottom: 0; left: 50%; translate: -50% 0; }
  .pos-bottom-right { bottom: 0; right: 0; }

  .meta {
    color: var(--color-muted);
  }

  .transcript {
    margin-top: var(--space-3);
  }

  .transcript summary {
    padding-block: var(--space-1);
    cursor: pointer;
  }

  .transcript pre {
    white-space: pre-wrap;
    font: inherit;
  }
</style>
