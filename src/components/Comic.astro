---
import type { Comic } from '../lib/comics';
import { transcript, fmtDate, isoDate, stripNumber } from '../lib/comics';
import { PANEL } from '../data/site';

interface Props {
  comic: Comic;
  headingId?: string;
  eager?: boolean;
}

const { comic, headingId = 'comic-title', eager = true } = Astro.props;
const { title, date, panels, placeholder } = comic.data;
const n = stripNumber(comic.id);
---

<article class="comic" aria-labelledby={headingId}>
  <header class="comic-head">
    <h1 id={headingId}>{title}</h1>
    <p class="meta">
      {n !== null && <span>Strip {n}</span>}
      <time datetime={isoDate(date)}>{fmtDate(date)}</time>
      {placeholder && <span>Placeholder art</span>}
    </p>
  </header>

  <ol class:list={['panels', `panels--${panels.length}`]} aria-label={`${panels.length} panels`}>
    {
      panels.map((p, i) => (
        <li class="panel">
          <img
            src={p.art}
            alt={p.alt}
            width={PANEL.width}
            height={PANEL.height}
            loading={eager && i < 2 ? 'eager' : 'lazy'}
            fetchpriority={eager && i === 0 ? 'high' : undefined}
            decoding="async"
          />
          {(['top', 'bottom'] as const).map((band) => {
            const lines = p.dialogue.filter((d) => d.position.startsWith(band));
            return lines.length > 0 && (
              <div class={`band band--${band}`}>
                {lines.map((d) => (
                  <p class:list={['line', `line--${d.kind}`, `pos-${d.position}`]}>
                    {d.kind === 'speech' || d.kind === 'thought' ? (
                      <span class="visually-hidden">{d.speaker}{d.kind === 'thought' ? ' thinks' : ' says'}: </span>
                    ) : null}
                    {d.text}
                  </p>
                ))}
              </div>
            );
          })}
        </li>
      ))
    }
  </ol>

  <details class="transcript">
    <summary>Read the transcript</summary>
    <pre>{transcript(comic)}</pre>
  </details>
</article>

<style>
  .comic-head {
    margin-bottom: var(--space-3);
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-3);
    margin: 0;
    color: var(--color-muted);
    font-weight: 600;
  }

  .panels {
    display: grid;
    gap: var(--gutter);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 768px) {
    .panels--2,
    .panels--4 {
      grid-template-columns: repeat(2, 1fr);
    }

    .panels--3,
    .panels--6 {
      grid-template-columns: repeat(3, 1fr);
    }

    .panels--5 {
      grid-template-columns: repeat(6, 1fr);
    }

    .panels--5 .panel {
      grid-column: span 2;
    }

    .panels--5 .panel:nth-child(-n + 2) {
      grid-column: span 3;
    }
  }

  .panel {
    position: relative;
    container-type: inline-size;
    border: var(--ink-line) solid var(--color-ink);
    background: var(--color-paper);
  }

  .panel img {
    width: 100%;
  }

  /* Lettering. Real text, set over the art. */
  /* Lettering sits in a top band and a bottom band. Each band is a wrapping
     flex row, so balloons and captions can never overlap: if two don't fit
     side by side, the second drops below the first. */
  .band {
    position: absolute;
    inset-inline: 0;
    z-index: 1;
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    gap: 0.5em 4%;
    padding: 4% 4% 0;
  }

  .band--top { top: 0; }
  .band--bottom { bottom: 0; padding: 0 4% 5%; align-items: flex-end; }

  .line {
    position: relative;
    max-width: 62%;
    margin: 0;
    padding: 0.45em 0.75em 0.5em;
    font-family: var(--font-letter);
    font-size: clamp(0.9rem, 4.6cqi, 1.15rem);
    font-weight: 560;
    line-height: 1.22;
    background: var(--color-paper);
    color: var(--color-ink);
    border: 2.5px solid var(--color-ink);
    border-radius: 1.1em;
  }

  /* Balloon tails: a small rotated square, pointing at whoever is talking. */
  .line--speech::after {
    content: '';
    position: absolute;
    left: 28%;
    width: 0.8em;
    height: 0.8em;
    background: var(--color-paper);
    border: 2.5px solid var(--color-ink);
    border-top-color: transparent;
    border-left-color: transparent;
  }

  .pos-top-left.line--speech::after,
  .pos-top.line--speech::after,
  .pos-top-right.line--speech::after {
    bottom: -0.48em;
    rotate: 45deg;
  }

  .pos-bottom-left.line--speech::after,
  .pos-bottom.line--speech::after,
  .pos-bottom-right.line--speech::after {
    top: -0.48em;
    rotate: 225deg;
  }

  .pos-top-right.line--speech::after,
  .pos-bottom-right.line--speech::after {
    left: auto;
    right: 28%;
  }

  .pos-top.line--speech::after,
  .pos-bottom.line--speech::after {
    left: calc(50% - 0.4em);
  }

  .line--thought {
    border-style: dashed;
    border-radius: 2em;
  }

  .line--caption {
    max-width: 55%;
    padding: 0.35em 0.6em 0.4em;
    font-size: clamp(0.75rem, 3.6cqi, 1rem);
    background: var(--color-yellow);
    border-radius: 0;
    font-family: var(--font-body);
    font-weight: 650;
  }

  .line--sfx {
    background: none;
    border: 0;
    color: var(--color-magenta);
    font-family: var(--font-body);
    font-weight: 900;
    font-size: clamp(1.2rem, 7cqi, 1.8rem);
    font-variation-settings: 'wdth' 125;
    font-stretch: 125%;
    rotate: -6deg;
  }

  /* Left, center, right within a band. Order is visual only; the DOM keeps
     the script's reading order. */
  .pos-top-left, .pos-bottom-left { order: 1; }
  .pos-top, .pos-bottom { order: 2; margin-inline: auto; }
  .pos-top-right, .pos-bottom-right { order: 3; margin-inline-start: auto; }
  .pos-top-left + .pos-top-right,
  .pos-bottom-left + .pos-bottom-right { margin-inline-start: auto; }

  .transcript {
    margin-top: var(--space-3);
  }

  .transcript summary {
    display: inline-block;
    padding-block: var(--space-2);
    font-weight: 650;
    cursor: pointer;
    color: var(--color-link);
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 0.18em;
  }

  .transcript pre {
    margin: var(--space-2) 0 0;
    padding: var(--space-3);
    border-left: var(--ink-line) solid var(--color-ink);
    white-space: pre-wrap;
    font-family: var(--font-body);
    font-size: var(--step-0);
    max-width: var(--measure);
  }
</style>
